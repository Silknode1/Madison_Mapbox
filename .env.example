# Copy this file to .env.local and fill it in. .env.local is git-ignored.

# --- Required ---------------------------------------------------------------
# Mapbox PUBLIC token (starts with "pk."). Create one at https://account.mapbox.com/access-tokens/
# Tip: add URL restrictions (localhost + your deployed domain) to the token.
VITE_MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN

# --- Optional: Supabase (places table + starred places synced between two phones) ---
# Leave these blank to run entirely from src/data.js with device-local stars.
# Dashboard -> Project Settings -> API: the Project URL and the publishable (anon) key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Shared secret both phones use to see the same starred places (8+ characters).
# Use the same value on both phones' builds, and don't share it.
VITE_TRIP_CODE=
